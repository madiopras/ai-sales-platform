# Application
APP_NAME=ai-sales-api
APP_ENV=development
LOG_LEVEL=debug

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8081
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# Infrastructure (gunakan nama service Docker saat API dijalankan di Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aisales
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable
REDIS_ADDR=localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=delodelo123
MINIO_ROOT_PASSWORD=delodelo123
MINIO_USE_SSL=false

# Authentication
# Use a unique random value of at least 32 characters in every environment.
AUTH_JWT_SECRET=nGXIzcH9GoR9ERNvFoEQ9KXiDO6uWhOwFNYjQqOp4xe
AUTH_JWT_ISSUER=ai-sales-platform
AUTH_ACCESS_TOKEN_TTL=15m
