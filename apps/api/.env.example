# Application
APP_NAME=ai-sales-api
APP_ENV=development
LOG_LEVEL=debug

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8081
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# Infrastructure (gunakan nama service Docker saat API dijalankan di Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_sales
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
REDIS_ADDR=localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_USE_SSL=false

# Authentication
# Use a unique random value of at least 32 characters in every environment.
AUTH_JWT_SECRET=nGXIzcH9GoR9ERNvFoEQ9KXiDO6uWhOwFNYjQqOp4xe
AUTH_JWT_ISSUER=ai-sales-platform
AUTH_ACCESS_TOKEN_TTL=15m

# Xendit (Phase 8 — Payment)
# Docs: https://docs.xendit.co/apidocs
# XENDIT_SECRET_KEY is used for HTTP Basic auth against the Xendit API.
# XENDIT_CALLBACK_TOKEN is compared to the `x-callback-token` header of incoming webhooks.
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_CALLBACK_TOKEN=

XENDIT_BASE_URL=https://api.xendit.co
XENDIT_INVOICE_DURATION=24h
XENDIT_SUCCESS_REDIRECT_URL=
XENDIT_FAILURE_REDIRECT_URL=
XENDIT_HTTP_TIMEOUT=15s

# Biteship (Phase 9 — Shipping)
# Docs: https://biteship.com/id/docs/intro
# BITESHIP_API_KEY is sent as the raw Authorization header on outbound calls.
# BITESHIP_WEBHOOK_TOKEN is compared to the auth token header on incoming webhooks.
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_TOKEN=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_HTTP_TIMEOUT=15s

# Rate + booking defaults
BITESHIP_DEFAULT_COURIERS=jne,jnt,sicepat,anteraja
BITESHIP_DEFAULT_WEIGHT=1000
BITESHIP_ORIGIN_POSTAL_CODE=

# Origin (warehouse) shipper details used when booking a shipment
BITESHIP_ORIGIN_CONTACT_NAME=
BITESHIP_ORIGIN_CONTACT_PHONE=
BITESHIP_ORIGIN_ADDRESS=
BITESHIP_ORIGIN_NOTE=

# How long an order stays `delivered` before the worker auto-completes it (BR-034)
BITESHIP_AUTOCOMPLETE_AFTER=72h

# Internal API (Phase 10)
# INTERNAL_SERVICE_TOKEN authenticates apps/ai against the /internal/v1 API. Use a
# unique random value; when empty the internal API fails closed (rejects all calls).
INTERNAL_SERVICE_TOKEN=

# Per-IP token-bucket rate limit for the unauthenticated webhook endpoints.
# WEBHOOK_RATE_PER_SEC is the sustained refill rate; WEBHOOK_RATE_BURST the max burst.
WEBHOOK_RATE_PER_SEC=5
WEBHOOK_RATE_BURST=10


