# Application
APP_NAME=ai-sales-ai
APP_ENV=development
LOG_LEVEL=INFO

# HTTP server (this service)
HTTP_HOST=0.0.0.0
HTTP_PORT=8090

# Backend (Go /internal/v1)
# BACKEND_SERVICE_TOKEN must match INTERNAL_SERVICE_TOKEN in apps/api/.env.
BACKEND_BASE_URL=http://localhost:8081
BACKEND_SERVICE_TOKEN=
BACKEND_TIMEOUT_SECONDS=10
BACKEND_MAX_RETRIES=2

# Redis (session/conversation state + idempotency)
REDIS_URL=redis://localhost:6379/0

# Conversation / session state (Phase A3)
# Idle timeout: a session with no activity for this long expires (seconds).
SESSION_TTL_SECONDS=1800
# Max messages kept in the rolling history window (LLM context budget).
SESSION_HISTORY_MAX=20

# Event-driven notifications (Phase A7)
# Opt-in: leave false for local/offline runs (no broker needed). Requires the
# `notifications` extra (aio-pika): pip install -e ".[notifications]".
NOTIFICATIONS_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Topic exchange the Go backend publishes order.* events to (see events.go).
RABBITMQ_EXCHANGE=domain.events
RABBITMQ_EXCHANGE_TYPE=topic
# Durable queue this service binds; event names double as routing keys.
RABBITMQ_QUEUE=ai.notifications
RABBITMQ_ROUTING_KEYS=order.paid,order.shipped,order.delivered,order.completed,order.cancelled
# Unacked messages in flight.
RABBITMQ_PREFETCH=10
# How long a processed event is remembered (dedup) — seconds.
EVENT_DEDUP_TTL_SECONDS=86400



# LLM (Phase A4)
# Empty provider = built-in rule-based orchestrator (no API key needed).
# Set to "openai" for an OpenAI-compatible chat-completions model with
# function calling.
LLM_PROVIDER=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
# Base URL for OpenAI-compatible chat completions (override for Azure/proxies).
LLM_API_BASE_URL=https://api.openai.com/v1
# Max tool-call round trips per turn (loop guard).
LLM_MAX_TOOL_ITERATIONS=4
# Optional overrides for the versioned prompt files (defaults resolve from
# docs/ai/ai-system-prompt.md and docs/ai/sales-rules.md).
LLM_SYSTEM_PROMPT_PATH=
LLM_SALES_RULES_PATH=


# WhatsApp (Phase A2)
# Provider selector: currently only "meta" (WhatsApp Cloud API) is implemented.
WA_PROVIDER=meta
# Token you set when registering the webhook; echoed back on the GET handshake.
WA_VERIFY_TOKEN=
# Permanent/system-user access token for the Cloud API (Bearer).
WA_ACCESS_TOKEN=
# Phone number id from the WhatsApp Business account.
WA_PHONE_NUMBER_ID=
# Graph API base; pin the version you target.
WA_API_BASE_URL=https://graph.facebook.com/v20.0
# App secret used to verify X-Hub-Signature-256 on inbound webhooks.
# Leave empty in local dev to skip signature checks; REQUIRED in production.
WA_APP_SECRET=
# Idempotency window for inbound message_id dedup (seconds).
WA_INBOUND_DEDUP_TTL_SECONDS=3600
# Retries when the provider send API fails.
WA_SEND_MAX_RETRIES=3
# Echo inbound text back as a placeholder reply (until LLM lands in Phase A4).
WA_ECHO_REPLY=true

