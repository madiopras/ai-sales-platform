    {
      "name": "WhatsApp Webhook",
      "description": "WhatsApp Cloud API webhook endpoints.\n\n- GET: Webhook verification (hub.challenge handshake)\n- POST: Inbound message processing from Meta",
      "item": [
        {
          "name": "Webhook Verification (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ai_base_url}}/whatsapp/webhook?hub.mode=subscribe&hub.verify_token={{wa_verify_token}}&hub.challenge=challenge_string_123",
              "host": ["{{ai_base_url}}"],
              "path": ["whatsapp", "webhook"],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe",
                  "description": "Must be 'subscribe' for Meta webhook verification"
                },
                {
                  "key": "hub.verify_token",
                  "value": "{{wa_verify_token}}",
                  "description": "The verify token configured in Meta dashboard and WA_VERIFY_TOKEN env var"
                },
                {
                  "key": "hub.challenge",
                  "value": "challenge_string_123",
                  "description": "Challenge string from Meta that must be echoed back"
                }
              ]
            },
            "description": "Meta Cloud API webhook verification handshake.\n\nMeta sends a GET request with hub.mode, hub.verify_token, and hub.challenge.\nThe service must respond with the challenge value if the verify_token matches."
          },
          "response": [
            {
              "name": "200 – Verification Successful",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{ai_base_url}}/whatsapp/webhook?hub.mode=subscribe&hub.verify_token={{wa_verify_token}}&hub.challenge=challenge_string_123",
                  "host": ["{{ai_base_url}}"],
                  "path": ["whatsapp", "webhook"],
                  "query": [
                    { "key": "hub.mode", "value": "subscribe" },
                    { "key": "hub.verify_token", "value": "{{wa_verify_token}}" },
                    { "key": "hub.challenge", "value": "challenge_string_123" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "text",
              "body": "challenge_string_123"
            },
            {
              "name": "403 – Invalid Verify Token",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{ai_base_url}}/whatsapp/webhook?hub.mode=subscribe&hub.verify_token=wrong-token&hub.challenge=challenge_string_123",
                  "host": ["{{ai_base_url}}"],
                  "path": ["whatsapp", "webhook"],
                  "query": [
                    { "key": "hub.mode", "value": "subscribe" },
                    { "key": "hub.verify_token", "value": "wrong-token" },
                    { "key": "hub.challenge", "value": "challenge_string_123" }
                  ]
                }
              },
              "status": "Forbidden",
              "code": 403,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"detail\": \"Verification failed\"\n}"
            }
          ]
        },
        {
          "name": "Inbound Message – Text (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Hub-Signature-256",
                "value": "sha256=<computed_hmac>",
                "description": "HMAC-SHA256 signature of the body using WA_APP_SECRET. Optional in dev (skipped if WA_APP_SECRET is empty).",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"BUSINESS_ACCOUNT_ID\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"628123456789\",\n              \"phone_number_id\": \"{{wa_phone_number_id}}\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"John Doe\"\n                },\n                \"wa_id\": \"628987654321\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"628987654321\",\n                \"id\": \"wamid.HBgNNjI4MTIzNDU2Nzg5FQIAERgSMEIxMjM0NTY3ODlBQkNERUYA\",\n                \"timestamp\": \"1700000000\",\n                \"text\": {\n                  \"body\": \"Halo, saya mau lihat katalog produk\"\n                },\n                \"type\": \"text\"\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{ai_base_url}}/whatsapp/webhook",
              "host": ["{{ai_base_url}}"],
              "path": ["whatsapp", "webhook"]
            },
            "description": "Simulates an inbound text message from Meta Cloud API.\n\nThe AI service will:\n1. Parse the Meta webhook payload\n2. Deduplicate by message_id\n3. Run the message through LLM orchestration (or rule-based fallback)\n4. Send a reply via the WhatsApp provider\n\nResponse is always 200 (ACK to Meta) regardless of processing outcome."
          },
          "response": [
            {
              "name": "200 – Acknowledged",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{ai_base_url}}/whatsapp/webhook",
                  "host": ["{{ai_base_url}}"],
                  "path": ["whatsapp", "webhook"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"ok\"\n}"
            }
          ]
        },
