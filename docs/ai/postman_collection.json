{
  "info": {
    "name": "AI Sales Platform – AI Service (FastAPI)",
    "description": "Postman collection for the AI Sales Platform AI micro-service.\n\nBase URL default: http://localhost:8090\n\nThe AI service exposes:\n- Health check endpoint\n- WhatsApp webhook (verification & inbound messages)\n- WhatsApp outbound send endpoint\n\nVariables:\n- {{ai_base_url}} – AI service base URL\n- {{wa_verify_token}} – WhatsApp webhook verify token\n- {{wa_phone_number_id}} – WhatsApp phone number ID\n- {{wa_access_token}} – WhatsApp access token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "ai_base_url",
      "value": "http://localhost:8090",
      "type": "string"
    },
    {
      "key": "wa_verify_token",
      "value": "my-verify-token",
      "type": "string"
    },
    {
      "key": "wa_phone_number_id",
      "value": "123456789",
      "type": "string"
    },
    {
      "key": "wa_access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Health check endpoints for the AI service.",
      "item": [
